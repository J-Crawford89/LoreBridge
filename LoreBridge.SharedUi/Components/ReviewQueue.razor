@using LoreBridge.Application.Review
@using LoreBridge.Core.Review
@inject IReviewService ReviewService
@inject NavigationManager Navigation

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert error">@errorMessage</div>
}
else if (isLoading)
{
    <p class="muted">Loading review queue...</p>
}
else if (items.Count == 0)
{
    <div class="empty-state compact">
        <h3>Queue clear</h3>
        <p>There are no staging notes waiting for review.</p>
    </div>
}
else if (Compact)
{
    <div class="review-list">
        @foreach (var item in VisibleItems)
        {
            <button type="button" @onclick="() => OpenItem(item)">
                <span class="review-icon" aria-hidden="true">◇</span>
                <span><strong>@item.Title</strong><small>@item.SourceRelativePath</small></span>
                <span class="badge warning">Needs review</span>
            </button>
        }
    </div>
}
else
{
    <div class="table-wrap">
        <table class="data-table">
            <thead><tr><th>Title</th><th>Status</th><th>Source</th><th>Created</th></tr></thead>
            <tbody>
                @foreach (var item in VisibleItems)
                {
                    <tr @onclick="() => OpenItem(item)" tabindex="0">
                        <td><strong>@item.Title</strong></td>
                        <td><span class="badge warning">@item.ReviewStatus.Replace('_', ' ')</span></td>
                        <td class="path-cell">@item.SourceRelativePath</td>
                        <td>@item.CreatedUtc.ToLocalTime().ToString("MMM d, yyyy")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    [Parameter, EditorRequired] public string WorkspaceId { get; set; } = string.Empty;
    [Parameter] public bool Compact { get; set; }
    [Parameter] public int? ItemLimit { get; set; }
    [Parameter] public EventCallback<int> OnCountChanged { get; set; }

    private readonly List<ReviewItem> items = [];
    private string? errorMessage;
    private bool isLoading;
    private IEnumerable<ReviewItem> VisibleItems => ItemLimit is > 0 ? items.Take(ItemLimit.Value) : items;

    protected override async Task OnParametersSetAsync() => await LoadReviewQueueAsync();

    private async Task LoadReviewQueueAsync()
    {
        if (string.IsNullOrWhiteSpace(WorkspaceId)) return;
        isLoading = true;
        errorMessage = null;
        items.Clear();
        try
        {
            items.AddRange((await ReviewService.GetReviewQueueAsync(WorkspaceId)).OrderByDescending(item => item.CreatedUtc));
            await OnCountChanged.InvokeAsync(items.Count);
        }
        catch (Exception ex) { errorMessage = ex.Message; }
        finally { isLoading = false; }
    }

    private void OpenItem(ReviewItem item) => Navigation.NavigateTo($"/notes/{Uri.EscapeDataString(item.SourceNoteId)}");
}

@using LoreBridge.Application.Vault
@using LoreBridge.Core.Vault
@using LoreBridge.SharedUi.State
@implements IDisposable
@inject IVaultService VaultService
@inject WorkspaceState WorkspaceState
@inject NavigationManager Navigation

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert error">@errorMessage</div>
}
else if (isLoading)
{
    <div class="loading-card">Loading vault overview...</div>
}
else if (WorkspaceState.SelectedWorkspace is null)
{
    <div class="empty-state">
        <h2>No workspaces configured</h2>
        <p>Add a workspace configuration path to begin using LoreBridge.</p>
    </div>
}
else if (snapshot is not null)
{
    <section class="metric-grid" aria-label="Vault statistics">
        <div class="metric-card accent">
            <span>Total articles</span>
            <strong>@snapshot.TotalNotes</strong>
            <small>Markdown notes in this vault</small>
        </div>
        <div class="metric-card">
            <span>In review</span>
            <strong>@reviewCount</strong>
            <small>Items awaiting attention</small>
        </div>
        <div class="metric-card">
            <span>Canon</span>
            <strong>@GetCount(snapshot.StatusCounts, "canon")</strong>
            <small>Authoritative articles</small>
        </div>
        <div class="metric-card">
            <span>Recently changed</span>
            <strong>@snapshot.RecentNotes.Count</strong>
            <small>Latest vault activity</small>
        </div>
    </section>

    <div class="dashboard-grid">
        <section class="card span-two">
            <div class="section-heading">
                <div>
                    <p class="eyebrow">Vault map</p>
                    <h2>Articles by folder</h2>
                </div>
                <button class="button secondary" type="button" @onclick="GoToBrowse">Browse vault</button>
            </div>
            @if (snapshot.TopLevelFolderCounts.Count == 0)
            {
                <p class="muted">No Markdown notes were found.</p>
            }
            else
            {
                <div class="distribution-list">
                    @foreach (var item in snapshot.TopLevelFolderCounts.OrderByDescending(item => item.Value))
                    {
                        <div class="distribution-row">
                            <div><span>@item.Key</span><strong>@item.Value</strong></div>
                            <div class="distribution-track">
                                <span style="width: @GetPercentage(item.Value, snapshot.TotalNotes)%"></span>
                            </div>
                        </div>
                    }
                </div>
            }
        </section>

        <section class="card">
            <div class="section-heading">
                <div>
                    <p class="eyebrow">Classification</p>
                    <h2>Article status</h2>
                </div>
            </div>
            <div class="count-list">
                @foreach (var item in snapshot.StatusCounts)
                {
                    <div><span><i class="status-dot"></i>@item.Key</span><strong>@item.Value</strong></div>
                }
            </div>
        </section>

        <section class="card span-two">
            <div class="section-heading">
                <div>
                    <p class="eyebrow">Needs attention</p>
                    <h2>Review queue</h2>
                </div>
                <button class="button secondary" type="button" @onclick="GoToReview">View all</button>
            </div>
            <ReviewQueue WorkspaceId="@(WorkspaceState.SelectedWorkspaceId!)" Compact="true" ItemLimit="5" OnCountChanged="SetReviewCount" />
        </section>

        <section class="card">
            <div class="section-heading">
                <div>
                    <p class="eyebrow">Activity</p>
                    <h2>Recently updated</h2>
                </div>
            </div>
            <div class="recent-list">
                @foreach (var note in snapshot.RecentNotes)
                {
                    <button type="button" @onclick="() => OpenNote(note.NoteId)">
                        <span><strong>@note.Title</strong><small>@note.RelativePath</small></span>
                        <time>@note.LastModifiedUtc.ToLocalTime().ToString("MMM d")</time>
                    </button>
                }
            </div>
        </section>
    </div>
}

@code {
    private VaultSnapshot? snapshot;
    private string? errorMessage;
    private bool isLoading = true;
    private int reviewCount;

    protected override async Task OnInitializedAsync()
    {
        WorkspaceState.Changed += OnWorkspaceChanged;
        await WorkspaceState.InitializeAsync();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        snapshot = null;
        errorMessage = null;
        if (string.IsNullOrWhiteSpace(WorkspaceState.SelectedWorkspaceId))
        {
            isLoading = false;
            return;
        }

        isLoading = true;
        try
        {
            snapshot = await VaultService.GetSnapshotAsync(WorkspaceState.SelectedWorkspaceId);
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OnWorkspaceChanged() => InvokeAsync(LoadAsync);
    private void SetReviewCount(int count) => reviewCount = count;
    private void GoToBrowse() => Navigation.NavigateTo("/browse");
    private void GoToReview() => Navigation.NavigateTo("/review");
    private void OpenNote(string noteId) => Navigation.NavigateTo($"/notes/{Uri.EscapeDataString(noteId)}");
    private static int GetCount(IReadOnlyDictionary<string, int> counts, string key) => counts.TryGetValue(key, out var count) ? count : 0;
    private static double GetPercentage(int count, int total) => total == 0 ? 0 : Math.Max(4, count * 100d / total);

    public void Dispose() => WorkspaceState.Changed -= OnWorkspaceChanged;
}

@using LoreBridge.Application.Notes
@using LoreBridge.Core.Notes
@inject INoteService NoteService

<h2>Create Staging Note</h2>

<div>
    <label for="staging-title">Title</label>
    <input id="staging-title" @bind="title" />
</div>

<div>
    <label for="staging-tags">Tags</label>
    <input id="staging-tags" @bind="tagsText" />
</div>

<div>
    <label for="staging-markdown">Markdown</label>
    <textarea id="staging-markdown" @bind="markdown"></textarea>
</div>

<button type="button" @onclick="CreateAsync" disabled="@isCreating">Create</button>

@if (!string.IsNullOrWhiteSpace(message))
{
    <p>@message</p>
}

@code {
    [Parameter]
    public string WorkspaceId { get; set; } = string.Empty;

    [Parameter]
    public EventCallback<CreateNoteResult> OnNoteCreated { get; set; }

    private string title = string.Empty;
    private string tagsText = string.Empty;
    private string markdown = string.Empty;
    private string? message;
    private bool isCreating;

    private async Task CreateAsync()
    {
        if (string.IsNullOrWhiteSpace(WorkspaceId))
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(title))
        {
            message = "Title is required.";
            return;
        }

        isCreating = true;
        message = null;

        try
        {
            var request = new CreateStagingNoteRequest(
                WorkspaceId,
                title,
                markdown,
                tagsText
                    .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                    .ToList());

            var result = await NoteService.CreateStagingNoteAsync(request);
            message = $"Created {result.RelativePath}.";
            title = string.Empty;
            tagsText = string.Empty;
            markdown = string.Empty;
            await OnNoteCreated.InvokeAsync(result);
        }
        catch (Exception ex)
        {
            message = ex.Message;
        }
        finally
        {
            isCreating = false;
        }
    }
}
